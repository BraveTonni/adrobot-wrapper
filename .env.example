# Docker Compose reads this file after it is copied to .env.
# The API key is supplied separately through backend/.secrets/keitaro_api_key.
BACKEND_PORT=8000

KEITARO_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1
KEITARO_ADMIN_URL=https://keitaro-for-tests.etolegko.com/admin
KEITARO_TIMEOUT=15
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=10332
DEFAULT_SOURCE_ID=836
GEO_REDIRECT_URL=https://google.com
# direct — изменения офферов сразу уходят в Keitaro; draft — после явной публикации.
EDITOR_PUBLISH_MODE=direct
OFFERS_CACHE_TTL=300
REFERENCE_CACHE_TTL=300
CAMPAIGN_SEARCH_LIMIT=500
LOG_LEVEL=INFO
LOG_DIRECTORY=../logs

# Next.js server-side backend connection
BACKEND_API_URL=http://127.0.0.1:8000

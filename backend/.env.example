# Keitaro Admin API (учебный стенд). Реальный ключ не коммитить.
KEITARO_URL=https://keitaro-for-tests.etolegko.com/admin_api/v1
KEITARO_API_KEY=
# Локальный токен API; задайте случайное значение не короче 32 символов.
API_ACCESS_TOKEN=
# Базовый URL админки; ссылки на кампании строятся как <KEITARO_ADMIN_URL>/#!/campaign.editor/<id>
KEITARO_ADMIN_URL=https://keitaro-for-tests.etolegko.com/admin
KEITARO_TIMEOUT=15

# Значения по умолчанию для новых кампаний (можно переопределить в форме)
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=10332
DEFAULT_SOURCE_ID=836
GEO_REDIRECT_URL=https://google.com

# TTL кэшей, секунды
OFFERS_CACHE_TTL=300
REFERENCE_CACHE_TTL=300
CAMPAIGN_SEARCH_LIMIT=500

# Локальная БД. SQLite — для простого старта; для Postgres замените строку.
DATABASE_URL=sqlite+aiosqlite:///./adrobot.db
# DATABASE_URL=postgresql+asyncpg://adrobot:adrobot@localhost:5432/adrobot

LOG_LEVEL=INFO
LOG_DIRECTORY=../logs
